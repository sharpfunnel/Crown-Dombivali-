# Copy to .env and fill in. Never commit the real .env.

# --- Core ---
DATABASE_URL="postgres://..."          # Neon Postgres connection string
ADMIN_PASSWORD="choose-a-strong-one"   # /admin login
SESSION_SECRET="long-random-string"    # signs the admin session cookie
CRON_SECRET="long-random-string"       # guards /api/cron/* routes

# --- Meta Pixel + Conversions API ---
# Leave these UNSET to keep both halves dormant. Set them ONLY after removing
# the Meta base-code and "Lead" tags from the GTM container, or leads will be
# counted twice. Both PIXEL_ID vars hold the SAME value on purpose: the server
# one must not be NEXT_PUBLIC_, and the browser cannot read the server one.
# NEXT_PUBLIC_* is inlined at BUILD time — changing it needs a redeploy.
META_PIXEL_ID="1768804417800908"              # dataset/pixel id, server-side only
NEXT_PUBLIC_META_PIXEL_ID="1768804417800908"  # same value, exposed to the browser
META_CAPI_ACCESS_TOKEN=""              # SECRET — Events Manager > Conversions API > generate token
META_CAPI_TEST_EVENT_CODE=""           # testing only; MUST be empty in production
META_GRAPH_API_VERSION="v21.0"         # optional; defaults to v21.0
NEXT_PUBLIC_SITE_URL="https://crown-dombivali.vercel.app"  # builds event_source_url

# --- Claude admin assistant ---
ANTHROPIC_API_KEY=""                   # SECRET — console.anthropic.com; leave unset to hide the chat widget

# --- Telegram lead notifications ---
# Leave both unset to keep this dormant. Message @BotFather -> /newbot for the
# token; message your new bot once, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates to read the chat id back.
TELEGRAM_BOT_TOKEN=""                  # SECRET — from @BotFather
TELEGRAM_CHAT_ID=""                    # chat/group id the bot posts new leads to
