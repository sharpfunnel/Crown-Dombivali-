# Copy to .env and fill in. Never commit the real .env.

# --- Core ---
DATABASE_URL="postgres://..."          # Neon Postgres connection string
ADMIN_PASSWORD="choose-a-strong-one"   # /admin login
SESSION_SECRET="long-random-string"    # signs the admin session cookie
CRON_SECRET="long-random-string"       # guards /api/cron/* routes

# --- Meta Pixel ---
# Leave unset to keep the pixel dormant. Set it ONLY after removing the Meta
# base-code and "Lead" tags from the GTM container, or leads will be counted
# twice. NEXT_PUBLIC_* is inlined at BUILD time — changing it needs a redeploy.
NEXT_PUBLIC_META_PIXEL_ID="1768804417800908"

# --- Claude admin assistant ---
ANTHROPIC_API_KEY=""                   # SECRET — console.anthropic.com; leave unset to hide the chat widget

# --- Telegram lead notifications ---
# Leave both unset to keep this dormant. Message @BotFather -> /newbot for the
# token; message your new bot once, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates to read the chat id back.
TELEGRAM_BOT_TOKEN=""                  # SECRET — from @BotFather
TELEGRAM_CHAT_ID=""                    # chat/group id the bot posts new leads to
