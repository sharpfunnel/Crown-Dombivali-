# Neon Postgres connection string used by the lead forms (server-side only).
# Copy this file to `.env` and paste your own connection string.
# Get it from the Neon dashboard → Connection Details (use the pooled string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Admin panel (/admin) — set your own values, and add them in the Vercel dashboard too.
ADMIN_PASSWORD="choose-a-strong-password"
# 64-char hex. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="generate-a-long-random-secret"

# Protects the daily analytics-cleanup cron (/api/cron/cleanup). Vercel sends this
# automatically as a Bearer token when you set it in the dashboard.
CRON_SECRET="generate-another-long-random-secret"
