# Copy to .env and fill in. Never commit the real .env.

# --- Core ---
DATABASE_URL="postgres://..."          # Neon Postgres connection string
ADMIN_PASSWORD="choose-a-strong-one"   # /admin login
SESSION_SECRET="long-random-string"    # signs the admin session cookie
CRON_SECRET="long-random-string"       # guards /api/cron/* routes

# --- Meta Conversions API (server-side Lead reporting) ---
# Leave these UNSET to keep CAPI dormant. Set them ONLY after removing the
# duplicate "Lead" tag from the GTM container, or leads will be counted twice.
META_PIXEL_ID="1768804417800908"       # the existing dataset/pixel id (server-side only)
META_CAPI_ACCESS_TOKEN=""              # SECRET — Events Manager > Conversions API > generate token
META_CAPI_TEST_EVENT_CODE=""           # testing only; MUST be empty in production
META_GRAPH_API_VERSION="v21.0"         # optional; defaults to v21.0
NEXT_PUBLIC_SITE_URL="https://crown-dombivali.vercel.app"  # builds event_source_url
